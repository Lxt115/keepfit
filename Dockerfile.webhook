FROM alpine:3.20

# 安装 webhook、git、docker CLI
RUN apk add --no-cache git docker-cli docker-cli-compose curl \
    && curl -fsSL https://github.com/adnanh/webhook/releases/download/2.8.3/webhook-linux-amd64.tar.gz \
       | tar -xz -C /tmp \
    && mv /tmp/webhook-linux-amd64/webhook /usr/local/bin/webhook \
    && rm -rf /tmp/webhook-linux-amd64

EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/webhook"]
