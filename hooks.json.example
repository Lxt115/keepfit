[
  {
    "id": "keepfit-deploy",
    "execute-command": "/bin/sh",
    "command-working-directory": "/home/ubuntu/keepfit",
    "pass-arguments-to-command": [
      {
        "source": "string",
        "name": "deploy.sh"
      }
    ],
    "response-message": "deploy triggered",
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "REPLACE_WITH_YOUR_WEBHOOK_SECRET",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    }
  }
]
